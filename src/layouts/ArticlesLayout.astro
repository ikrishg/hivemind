---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import RootLayout from "~layouts/RootLayout.astro";
import { chunk, formatDate } from "~lib/utils";
import { site } from "~shared";

const ARTICLES_PER_PAGE = 12;
const PRIORITY_IMAGES = 3;

export interface Props {
  pageNumber: number;
}

const { pageNumber } = Astro.props;

const articles = await getCollection(
  "articles",
  ({ data }) => !data.draft,
).catch(() => []);

const externalArticles = await getCollection("externalArticles").catch(
  () => [],
);

const data = [
  ...articles.map((article) => ({
    title: article.data.title,
    description: article.data.description,
    date: article.data.date,
    cover: article.data.cover,
    href: new URL(`/p/${article.id}`, site),
    external: false,
  })),
  ...externalArticles.map((article) => ({
    title: article.data.title,
    description: article.data.description,
    date: article.data.date,
    cover: article.data.cover,
    href: String(article.data.url),
    external: true,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const pages = chunk(data, ARTICLES_PER_PAGE);
const pageArticles = pages[pageNumber - 1] ?? [];
const totalPages = pages.length;
---

<RootLayout
  head={{
    title:
      pageNumber === 1
        ? "Articles | Krish Gupta"
        : `Articles — Page ${pageNumber} | Krish Gupta`,
    description: "Articles by Krish Gupta",
  }}
  class:list={["mx-8"]}
>
  <main class="py-8 sm:py-14">
    <h1
      class="font-serif text-6xl font-bold text-foreground max-h-24 md:text-8xl"
    >
      <span class="sr-only">Krish Gupta's </span>Articles
    </h1>

    <div class="mt-8 mb-16 flex flex-wrap items-stretch justify-start gap-16">
      {
        pageArticles.map((article, index) => (
          <article class="flex max-w-sm grow flex-col gap-2">
            <Image
              src={article.cover}
              densities={[0.5, 1, 2]}
              alt={article.title}
              width={350}
              class="mb-2 rounded"
              loading={index <= PRIORITY_IMAGES ? "eager" : "lazy"}
              fetchpriority={index <= PRIORITY_IMAGES ? "high" : "low"}
            />
            <a
              href={article.href}
              target={article.external ? "_blank" : undefined}
              rel={article.external ? "noopener noreferrer" : undefined}
              class="mb-2 underline-offset-8 hover:underline"
            >
              <h2 class="font-serif text-2xl font-semibold">{article.title}</h2>
            </a>
            <p class="text-sm text-foreground/70">{formatDate(article.date)}</p>
            <p class="mt-2 max-w-prose grow text-sm">{article.description}</p>
            <a
              href={article.href}
              target={article.external ? "_blank" : undefined}
              rel={article.external ? "noopener noreferrer" : undefined}
              class="mb-2 mt-4 underline-offset-8 hover:underline"
            >
              Read {article.external && `on ${new URL(article.href).hostname}`}{" "}
              &rarr;
            </a>
          </article>
        ))
      }
    </div>

    {
      totalPages > 1 ? (
        <footer class="mx-auto mb-12 lg:mx-0">
          <nav
            class="flex justify-center gap-4"
            aria-label="Articles pagination"
          >
            {Array.from({ length: totalPages }, (_, index) => {
              const page = index + 1;
              const href =
                page === 1
                  ? new URL("/articles", site)
                  : new URL(`/articles/${page}`, site);

              return (
                <a
                  href={href}
                  class:list={[
                    "px-4 py-2 font-serif text-sm",
                    "border border-black/10",
                    "hover:bg-foreground/5",
                    pageNumber === page
                      ? "pointer-events-none bg-foreground/10"
                      : "",
                  ]}
                  aria-current={pageNumber === page ? "page" : undefined}
                >
                  {page}
                </a>
              );
            })}
          </nav>
        </footer>
      ) : null
    }
  </main>
</RootLayout>
