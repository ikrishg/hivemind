---
import { Image } from "astro:assets";
import type { WorkEntry } from "~lib/SiteContent";
import { SiteContent } from "~lib/SiteContent";

export interface Props {
  entry: WorkEntry;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const accentClass = entry.accent ? `accent-dot--${entry.accent}` : "accent-dot--cobalt";
const outcome = SiteContent.formatWorkOutcome(entry);
---

<article class="group flex flex-col">
  <a
    href={entry.href}
    class="block overflow-hidden"
    target="_blank"
    rel="noopener noreferrer"
  >
    <div class="aspect-[4/3] overflow-hidden bg-rule">
      <Image
        src={entry.image}
        alt={`${entry.name} cover`}
        width={640}
        height={480}
        class="h-full w-full object-cover slow-hover-image group-hover:opacity-92"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />
    </div>
  </a>

  <div class="caption-block mt-0 flex flex-1 flex-col">
    <h3 class="caption-block__title">
      <a
        href={entry.href}
        class="slow-hover hover:opacity-70"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class:list={["accent-dot", accentClass]} aria-hidden="true" />
        {entry.name}
      </a>
    </h3>

    {
      (entry.year || entry.context || entry.role) && (
        <p class="caption-block__meta">
          {entry.year && <span>{entry.year}</span>}
          {entry.context && <span>{entry.context}</span>}
          {entry.role && <span>{entry.role}</span>}
        </p>
      )
    }

    {
      outcome && (
        <p class="caption-block__outcome">
          {outcome}
        </p>
      )
    }
  </div>
</article>
