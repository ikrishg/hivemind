---
import WritingEntry from "~components/WritingEntry.astro";
import type { WritingPiece } from "~lib/WritingCatalog";

export interface Props {
  years: { year: number; pieces: WritingPiece[] }[];
}

const { years } = Astro.props;
---

<div>
  {
    years.map(({ year, pieces }, yearIndex) => (
      <section class:list={[yearIndex > 0 && "mt-16"]}>
        <h2 class="micro-label border-b border-rule pb-3">{year}</h2>
        <div>
          {pieces.map((piece) => (
            <WritingEntry piece={piece} />
          ))}
        </div>
      </section>
    ))
  }
</div>
