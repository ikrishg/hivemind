---
import type { WritingPiece } from "~lib/WritingCatalog";
import { formatDate } from "~lib/utils";

export interface Props {
  piece: WritingPiece;
}

const { piece } = Astro.props;
---

<article class="writing-row group">
  <time
    datetime={piece.date.toISOString()}
    class="writing-row__date"
  >
    {formatDate(piece.date, {
      month: "short",
      day: "numeric",
      year: "numeric",
    })}
  </time>

  <div>
    <h2 class="writing-row__title">
      <a
        href={piece.href}
        class="slow-hover hover:opacity-70"
        target={piece.external ? "_blank" : undefined}
        rel={piece.external ? "noopener noreferrer" : undefined}
      >
        {piece.title}
        {piece.external ? " ↗" : ""}
      </a>
    </h2>

    {
      piece.description && (
        <p class="writing-row__dek">{piece.description}</p>
      )
    }

    <p class="writing-row__kind">{piece.kind}</p>
  </div>
</article>
