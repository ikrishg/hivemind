---

import CielImage from "~assets/ciel.webp";
import ReseterCSSImage from "~assets/resetercss.webp";
import ShipCultImage from "~assets/shipcult.webp";
import ImageLink from "~components/ImageLink.astro";
---

<section
  id="preface"
  class:list={[
    "flex min-h-screen w-full flex-col items-center",
    "px-4 pt-20 pb-8",
  ]}
>
  <div
    class="flex flex-1 flex-col items-center justify-center px-4 md:px-8 lg:px-12 gap-4"
  >
    <h1 class="text-center text-7xl md:text-8xl">Krish Gupta</h1>
    <p class="text-center text-xl md:text-2xl">
      perfectionist overkill engineer & poet
    </p>
    <hr class="w-1/3 min-w-3xs max-w-prose border-foreground/15" />
    <p class="overflow-visible text-justify max-w-prose">
      At 12, I shipped <ImageLink
        text="Reseter.css"
        link="https://github.com/kkrishguptaa/reseter.css"
        image={ReseterCSSImage}
      />, it got used by millions of developers. Since then, I've done software
      engineering and developer relations at multiple startups. Currently, I'm
      building <ImageLink
        text="Ciel"
        link="https://withciel.com"
        image={CielImage}
      /> and organising <ImageLink
        text="ShipCult"
        link="https://shipcult.com"
        image={ShipCultImage}
      /> a 12 week program for people who don't wait for things to happen, but take
      charge themselves.
    </p>
  </div>
</section>
