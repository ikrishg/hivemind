---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Coming Soon",
  description = "Krish is still writing / designing this page in his head 🫡",
} = Astro.props;
---

<section class="prose prose-xl mx-auto py-20 text-center md:py-28">
  <h1>
    {title}
  </h1>
  <p>
    {description}
  </p>
</section>
