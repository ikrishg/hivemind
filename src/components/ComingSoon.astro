---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Coming Soon",
  description = "Krish is still writing / designing this page in his head 🫡",
} = Astro.props;
---

<section class="px-8 prose mx-auto py-20 text-center">
  <h1>
    {title}
  </h1>
  <p>
    {description}
  </p>
</section>
