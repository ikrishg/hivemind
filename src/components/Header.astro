---
import { site, title, socials, navigations } from "~shared";
import TwitterIcon from "./icons/TwitterIcon.astro";
import InstagramIcon from "./icons/InstagramIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import SubstackIcon from "./icons/SubstackIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import EmailIcon from "./icons/EmailIcon.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import XIcon from "./icons/XIcon.astro";

const socialLinks = [
  { icon: TwitterIcon, href: socials.x, label: "X" },
  { icon: InstagramIcon, href: socials.instagram, label: "Instagram" },
  { icon: LinkedInIcon, href: socials.linkedin, label: "LinkedIn" },
  { icon: SubstackIcon, href: socials.substack, label: "Substack" },
  { icon: GitHubIcon, href: socials.github, label: "GitHub" },
  { icon: EmailIcon, href: socials.email, label: "Email" },
] as const;

const headerGroups = navigations.map(({ items }) =>
  items.filter(({ footerOnly }) => !footerOnly),
);
---

<header class="site-header border-b border-foreground/10 py-4">
  <div class="mx-8 flex items-center justify-between gap-4">
    <a
      class="relative z-50 font-serif text-xl font-semibold transition-colors duration-300 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
      href={new URL("/", site)}
    >
      {title}
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-4">
        {
          headerGroups.map((items) => (
            <>
              {items.map((item) => (
                <li>
                  <a
                    href={new URL(item.href, site)}
                    class="text-sm font-medium underline-offset-4 transition-colors duration-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
              <li aria-hidden="true" class="select-none text-foreground/35">
                •
              </li>
            </>
          ))
        }
        {
          socialLinks.map(({ icon: Icon, href, label }) => (
            <li>
              <a
                href={href}
                class="block text-foreground transition-colors duration-300 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                aria-label={label}
                target={href.startsWith("mailto:") ? undefined : "_blank"}
                rel={
                  href.startsWith("mailto:") ? undefined : "noopener noreferrer"
                }
              >
                <Icon class="size-4" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-nav relative z-50 lg:hidden">
      <input
        type="checkbox"
        id="mobile-nav-toggle"
        class="mobile-nav-checkbox peer"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
      />

      <label
        for="mobile-nav-toggle"
        class="mobile-nav-toggle peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-foreground"
      >
        <span class="sr-only">Menu</span>
        <MenuIcon class="mobile-nav-icon-open size-6" aria-hidden="true" />
        <XIcon class="mobile-nav-icon-close size-6" aria-hidden="true" />
      </label>

      <nav
        id="mobile-nav-panel"
        class="mobile-nav-panel"
        aria-label="Mobile primary"
      >
        <ul class="flex flex-col gap-5">
          {
            headerGroups.map((items, groupIndex) => (
              <>
                {groupIndex > 0 && (
                  <li aria-hidden="true" class="py-1 text-foreground/30">
                    •
                  </li>
                )}
                {items.map((item) => (
                  <li>
                    <a
                      href={new URL(item.href, site)}
                      class="text-2xl font-medium underline-offset-4 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </>
            ))
          }
        </ul>

        <ul class="mt-10 flex flex-wrap items-center gap-5">
          {
            socialLinks.map(({ icon: Icon, href, label }) => (
              <li>
                <a
                  href={href}
                  class="block text-foreground transition-colors duration-300 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                  aria-label={label}
                  target={href.startsWith("mailto:") ? undefined : "_blank"}
                  rel={
                    href.startsWith("mailto:")
                      ? undefined
                      : "noopener noreferrer"
                  }
                >
                  <Icon class="size-5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav-checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .mobile-nav-toggle {
    position: relative;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    color: var(--foreground);
    border-radius: 0.25rem;
    transition: color 0.2s ease;
  }

  .mobile-nav-toggle:hover {
    color: #000;
  }

  .mobile-nav-checkbox:focus-visible + .mobile-nav-toggle {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .mobile-nav-icon-open,
  .mobile-nav-icon-close {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .mobile-nav-icon-close {
    opacity: 0;
    transform: rotate(-72deg) scale(0.9);
  }

  .mobile-nav-checkbox:checked + .mobile-nav-toggle .mobile-nav-icon-open {
    opacity: 0;
    transform: rotate(72deg) scale(0.9);
  }

  .mobile-nav-checkbox:checked + .mobile-nav-toggle .mobile-nav-icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .mobile-nav-panel {
    --origin-x: calc(100% - 2.25rem);
    --origin-y: 1.85rem;

    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6.5rem 2rem 3rem;
    background: var(--background);
    pointer-events: none;
    visibility: hidden;
    clip-path: circle(0% at var(--origin-x) var(--origin-y));
    transition:
      clip-path 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.48s;
  }

  .mobile-nav-checkbox:checked ~ .mobile-nav-panel {
    pointer-events: auto;
    visibility: visible;
    clip-path: circle(150% at var(--origin-x) var(--origin-y));
    transition:
      clip-path 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  body:has(.mobile-nav-checkbox:checked) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-panel,
    .mobile-nav-checkbox:checked ~ .mobile-nav-panel,
    .mobile-nav-icon-open,
    .mobile-nav-icon-close {
      transition-duration: 0.01ms;
    }

    .mobile-nav-panel {
      clip-path: none;
      opacity: 0;
      transition:
        opacity 0.01ms linear,
        visibility 0s linear 0.01ms;
    }

    .mobile-nav-checkbox:checked ~ .mobile-nav-panel {
      opacity: 1;
      transition:
        opacity 0.01ms linear,
        visibility 0s linear 0s;
    }
  }
</style>

<script>
  const toggle = document.getElementById(
    "mobile-nav-toggle",
  ) as HTMLInputElement | null;
  const panel = document.getElementById("mobile-nav-panel");

  if (toggle && panel) {
    const sync = () => {
      const open = toggle.checked;
      toggle.setAttribute("aria-expanded", String(open));
      panel.toggleAttribute("inert", !open);
    };

    sync();
    toggle.addEventListener("change", sync);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.checked) {
        toggle.checked = false;
        toggle.dispatchEvent(new Event("change"));
        toggle.focus();
      }
    });
  }
</script>
