---
import { Image } from "astro:assets";
import RootLayout from "~layouts/RootLayout.astro";
import WorkTile from "~components/WorkTile.astro";
import { SiteContent } from "~lib/SiteContent";
import portrait from "~assets/krish-portrait.jpg";
import opensourceBigContributions from "~assets/opensource-big-contributions.webp";
import { description, title } from "~shared";

const work = SiteContent.getHomeWork();
const reseter = work[0];
---

<RootLayout head={{ title, description }}>
  <div class="site-shell">
    <header class="max-w-4xl">
      <p class="display-serif text-4xl md:text-5xl lg:text-[3.25rem]">
        {SiteContent.thesis}
      </p>
    </header>

    <section class="mt-16 lg:mt-24">
      <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-20">
        <a
          href={reseter.href}
          class="group block"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="aspect-[5/4] overflow-hidden bg-rule lg:aspect-[4/3]">
            <Image
              src={opensourceBigContributions}
              alt=""
              width={800}
              height={640}
              class="h-full w-full object-cover slow-hover-image group-hover:opacity-92"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="caption-block">
            <p class="micro-label">Lead project</p>
            <h2 class="caption-block__title mt-2">
              <span class="accent-dot accent-dot--cobalt" aria-hidden="true" />
              {reseter.name}
            </h2>
            {
              reseter.outcome && (
                <p class="caption-block__outcome">{reseter.outcome}</p>
              )
            }
          </div>
        </a>

        <div class="flex flex-col items-start gap-8 lg:pt-2">
          <Image
            src={portrait}
            alt="Portrait of Krish Gupta"
            width={240}
            height={300}
            class="aspect-[4/5] w-44 object-cover md:w-52"
            loading="eager"
          />
          <div class="max-w-xs space-y-3">
            <p class="micro-label">{title}</p>
            <p class="text-base leading-relaxed text-ink-muted">
              Engineer, builder, sidequester — {SiteContent.age}. Based in
              Bengaluru ({SiteContent.timezone}).
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="site-rule mt-20 lg:mt-28" />

    <section class="mt-16 lg:mt-20">
      <div class="mb-10 flex items-baseline justify-between gap-4">
        <h2 class="display-serif text-3xl md:text-4xl">Selected work</h2>
        <a href="/work" class="micro-label slow-hover hover:text-ink">
          All work →
        </a>
      </div>

      <ul
        class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3"
        role="list"
      >
        {
          work.map((entry, index) => (
            <li>
              <WorkTile entry={entry} priority={index === 0} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</RootLayout>
