---
import RootLayout from "~layouts/RootLayout.astro";
import YearGroupedWritingList from "~components/YearGroupedWritingList.astro";
import { WritingCatalog } from "~lib/WritingCatalog";

const pieces = await WritingCatalog.loadByKind("essay");
const years = WritingCatalog.groupByYear(pieces);
---

<RootLayout
  head={{
    title: "Essays | Krish Gupta",
    description: "Essays by Krish Gupta",
  }}
>
  <div class="site-shell site-shell--narrow">
    <header class="space-y-4">
      <p class="micro-label">Archive</p>
      <h1 class="display-serif text-5xl md:text-6xl">Essays</h1>
      <nav class="text-sm text-ink-muted" aria-label="Writing">
        <a href="/writing" class="underline-offset-4 slow-hover hover:underline">
          ← All writing
        </a>
      </nav>
    </header>

    <div class="mt-16 lg:mt-20">
      <YearGroupedWritingList years={years} />
    </div>
  </div>
</RootLayout>
