---
import { Image } from "astro:assets";
import RootLayout from "~layouts/RootLayout.astro";
import { WritingCatalog } from "~lib/WritingCatalog";

const poems = await WritingCatalog.loadByKind("poem");
---

<RootLayout
  head={{
    title: "Poems | Krish Gupta",
    description: "Poems by Krish Gupta — a quiet gallery.",
  }}
  class:list="poems-gallery"
>
  <div class="poems-gallery__inner mx-8 py-16 lg:py-24">
    <header class="max-w-2xl space-y-4">
      <h1 class="font-serif text-5xl font-bold md:text-6xl">Poems</h1>
      <p class="text-lg leading-relaxed text-foreground/80">
        Small pieces, set apart — wander through at your own pace.
      </p>
    </header>

    {
      poems.length > 0 ? (
        <ul
          class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {poems.map((poem, index) => (
            <li class="poems-gallery__card group">
              <a
                href={poem.href}
                class="block h-full"
                target={poem.external ? "_blank" : undefined}
                rel={poem.external ? "noopener noreferrer" : undefined}
              >
                {poem.cover ? (
                  <div class="poems-gallery__frame overflow-hidden rounded-sm">
                    <Image
                      src={poem.cover}
                      alt=""
                      width={480}
                      height={360}
                      class="poems-gallery__image aspect-[4/3] w-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
                      loading={index < 3 ? "eager" : "lazy"}
                      fetchpriority={index < 3 ? "high" : "low"}
                    />
                  </div>
                ) : (
                  <div
                    class="poems-gallery__frame poems-gallery__placeholder aspect-[4/3] rounded-sm"
                    aria-hidden="true"
                  />
                )}
                <div class="mt-4 space-y-2">
                  <h2 class="font-serif text-2xl font-semibold leading-snug group-hover:underline underline-offset-4">
                    {poem.title}
                    {poem.external ? " ↗" : ""}
                  </h2>
                  {poem.description ? (
                    <p class="text-sm leading-relaxed text-foreground/75 line-clamp-3">
                      {poem.description}
                    </p>
                  ) : null}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-16 max-w-md text-foreground/70">
          Nothing here yet — poems will appear in this gallery when they are
          published.
        </p>
      )
    }
  </div>
</RootLayout>

<style>
  .poems-gallery {
    background: linear-gradient(
      165deg,
      var(--background) 0%,
      #e4d4c0 45%,
      #ddd0bc 100%
    );
    min-height: 100%;
  }

  .poems-gallery__frame {
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    background: color-mix(in srgb, var(--background) 60%, white);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--foreground) 6%, transparent),
      0 12px 32px color-mix(in srgb, var(--foreground) 8%, transparent);
    transition: box-shadow 0.5s ease;
  }

  .poems-gallery__card:hover .poems-gallery__frame {
    box-shadow:
      0 2px 4px color-mix(in srgb, var(--foreground) 8%, transparent),
      0 20px 48px color-mix(in srgb, var(--foreground) 14%, transparent);
  }

  .poems-gallery__placeholder {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--foreground) 6%, var(--background)),
      color-mix(in srgb, var(--foreground) 12%, var(--background))
    );
  }

  .poems-gallery__image {
    filter: saturate(0.92) contrast(0.98);
  }

  .poems-gallery__card:hover .poems-gallery__image {
    filter: saturate(1) contrast(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .poems-gallery__image {
      transition: none;
    }
  }
</style>
