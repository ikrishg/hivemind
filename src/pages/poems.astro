---
import RootLayout from "~layouts/RootLayout.astro";
import { WritingCatalog } from "~lib/WritingCatalog";

const poems = await WritingCatalog.loadByKind("poem");
---

<RootLayout
  head={{
    title: "Poems | Krish Gupta",
    description: "Poems by Krish Gupta — typographic sheets on paper.",
  }}
>
  <div class="site-shell">
    <header class="max-w-2xl space-y-4">
      <p class="micro-label">Poetry</p>
      <h1 class="display-serif text-5xl md:text-6xl">Poems</h1>
      <p class="text-lg leading-relaxed text-ink-muted">
        Small pieces on paper — wander through at your own pace.
      </p>
    </header>

    {
      poems.length > 0 ? (
        <ul
          class="mt-16 grid gap-8 sm:grid-cols-2 lg:mt-24 lg:grid-cols-3 lg:gap-10"
          role="list"
        >
          {poems.map((poem, index) => (
            <li class="group">
              <a
                href={poem.href}
                class="block h-full"
                target={poem.external ? "_blank" : undefined}
                rel={poem.external ? "noopener noreferrer" : undefined}
              >
                <div
                  class="poem-sheet aspect-[4/3] flex flex-col justify-between p-6 lg:p-8"
                  style={`--sheet-tint: ${WritingCatalog.poemSheetTint(index)}`}
                >
                  <h2 class="font-serif text-2xl font-semibold leading-snug tracking-tight">
                    {poem.title}
                    {poem.external ? " ↗" : ""}
                  </h2>
                  {poem.description ? (
                    <p class="text-sm leading-relaxed text-ink-muted italic line-clamp-4">
                      {poem.description}
                    </p>
                  ) : null}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</RootLayout>

<style>
  .poem-sheet {
    border-top: 1px solid var(--rule);
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--sheet-tint) 12%, var(--paper)) 0%,
      var(--paper) 55%,
      color-mix(in srgb, var(--sheet-tint) 8%, var(--paper)) 100%
    );
    transition: background 0.6s ease;
  }

  .group:hover .poem-sheet {
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--sheet-tint) 18%, var(--paper)) 0%,
      var(--paper) 50%,
      color-mix(in srgb, var(--sheet-tint) 12%, var(--paper)) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .poem-sheet {
      transition: none;
    }
  }
</style>
