---
import RootLayout from "~layouts/RootLayout.astro";
import { WritingCatalog } from "~lib/WritingCatalog";

const poems = await WritingCatalog.loadByKind("poem");
---

<RootLayout
  head={{
    title: "Poems | Krish Gupta",
    description: "Poems by Krish Gupta — a quiet gallery.",
  }}
  class:list="poems-gallery"
>
  <div class="poems-gallery__inner mx-8 py-16 lg:py-24">
    <header class="max-w-2xl space-y-4">
      <h1 class="font-serif text-5xl font-bold md:text-6xl">Poems</h1>
      <p class="text-lg leading-relaxed text-foreground/80">
        Small pieces, set apart — wander through at your own pace.
      </p>
    </header>

    {
      poems.length > 0 ? (
        <ul
          class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {poems.map((poem, index) => (
            <li class="poems-gallery__card group">
              <a
                href={poem.href}
                class="block h-full"
                target={poem.external ? "_blank" : undefined}
                rel={poem.external ? "noopener noreferrer" : undefined}
              >
                <div
                  class="poems-gallery__sheet aspect-[4/3] flex flex-col justify-between rounded-sm p-6"
                  style={`--sheet-tint: ${WritingCatalog.poemSheetTint(index)}`}
                >
                  <h2 class="font-serif text-2xl font-semibold leading-snug">
                    {poem.title}
                    {poem.external ? " ↗" : ""}
                  </h2>
                  {poem.description ? (
                    <p class="text-base leading-relaxed text-foreground/75 italic line-clamp-4">
                      {poem.description}
                    </p>
                  ) : null}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-16 max-w-md text-foreground/70">
          Nothing here yet — poems will appear in this gallery when they are
          published.
        </p>
      )
    }
  </div>
</RootLayout>

<style>
  .poems-gallery {
    background: linear-gradient(
      165deg,
      var(--background) 0%,
      #e4d4c0 45%,
      #ddd0bc 100%
    );
    min-height: 100%;
  }

  .poems-gallery__sheet {
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--sheet-tint) 18%, white) 0%,
      color-mix(in srgb, var(--sheet-tint) 8%, #f8f4ec) 55%,
      color-mix(in srgb, var(--sheet-tint) 14%, #efe6d8) 100%
    );
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--foreground) 6%, transparent),
      0 12px 32px color-mix(in srgb, var(--foreground) 8%, transparent);
    transition:
      box-shadow 0.5s ease,
      transform 0.5s ease;
  }

  .poems-gallery__card:hover .poems-gallery__sheet {
    box-shadow:
      0 2px 4px color-mix(in srgb, var(--foreground) 8%, transparent),
      0 20px 48px color-mix(in srgb, var(--foreground) 14%, transparent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .poems-gallery__sheet {
      transition: none;
    }
  }
</style>
