---
import RootLayout from "~layouts/RootLayout.astro";
import { WritingCatalog } from "~lib/WritingCatalog";

const poems = await WritingCatalog.loadByKind("poem");
---

<RootLayout
  head={{
    title: "Poems | Krish Gupta",
    description: "Poems by Krish Gupta — typographic cards in charcoal and midnight.",
  }}
  class="poems-charcoal"
>
  <div class="site-shell">
    <header class="max-w-2xl space-y-4">
      <p class="micro-label">Poetry</p>
      <h1 class="display-serif text-5xl md:text-6xl">Poems</h1>
      <p class="text-lg leading-relaxed text-[var(--poem-ink-muted)]">
        Small pieces set apart — wander through at your own pace.
      </p>
    </header>

    {
      poems.length > 0 ? (
        <ul
          class="mt-16 grid gap-8 sm:grid-cols-2 lg:mt-24 lg:grid-cols-3 lg:gap-10"
          role="list"
        >
          {poems.map((poem, index) => (
            <li class="group">
              <a
                href={poem.href}
                class="block h-full"
                target={poem.external ? "_blank" : undefined}
                rel={poem.external ? "noopener noreferrer" : undefined}
              >
                <div
                  class="poem-card aspect-[4/3] flex flex-col justify-between p-6 lg:p-8"
                  style={`--card-accent: ${WritingCatalog.poemCardAccent(index)}`}
                >
                  <h2 class="poem-card__title">
                    {poem.title}
                    {poem.external ? " ↗" : ""}
                  </h2>
                  {poem.description ? (
                    <p class="poem-card__line line-clamp-4">
                      {poem.description}
                    </p>
                  ) : null}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</RootLayout>

<style>
  @media (prefers-reduced-motion: reduce) {
    .poem-card {
      transition: none;
    }
  }
</style>
