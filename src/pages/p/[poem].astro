---
import { getCollection, render } from "astro:content";
import RootLayout from "~layouts/RootLayout.astro";
import { formatDate } from "~lib/utils";
import { site, socials } from "~shared";

export async function getStaticPaths() {
  const poems = await getCollection("poems");

  return poems.map((poem) => ({
    params: { poem: poem.id },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const { Content } = await render(poem);
---

<RootLayout
  head={{
    title: poem.data.title + " | Poem by Krish Gupta",
    description: poem.data.description,
    ogp: {
      type: "article",
      image: poem.data.cover,
      article: {
        publishedTime: poem.data.date.toISOString(),
        modifiedTime: poem.data.date.toISOString(),
        tags: poem.data.tags ?? ["poem"],
      },
    },
    canonical: poem.data.canonical,
  }}
  hideTemplate={true}
>
  <article
    class:list={[
      "my-8",
      "font-serif",
      "prose prose-poem max-w-2xl",
      "prose-headings:text-ink",
      "prose-headings:font-semibold",
      "mx-auto px-[var(--gutter)]",
      "leading-loose text-ink",
    ]}
  >
    <header class="not-prose mb-4 text-sm">
      <nav>
        <a href={new URL("/", site)} class="underline">home</a> /
        <a href={new URL("/poems", site)} class="underline">poems</a> /
        <span class="text-foreground/70">{poem.id}</span>
      </nav>
    </header>
    <div class="mb-4 text-sm text-foreground/70">
      <time datetime={poem.data.date.toISOString()}>
        {formatDate(poem.data.date)}
      </time>
    </div>
    <hr class="border-foreground/50 mt-0! mb-8!" />
    <h1>{poem.data.title}</h1>
    <Content />
    <hr class="border-foreground/50 my-8!" />
    <footer class="text-sm font-semibold space-y-6">
      {
        poem.data.canonical && (
          <div>
            <a href={poem.data.canonical} class="underline" target="_blank">
              originally published on {new URL(poem.data.canonical).hostname}
            </a>
          </div>
        )
      }
      <div class="flex flex-wrap gap-2 items-center justify-between">
        <span>
          © {new Date().getFullYear()}{" "}
          <a href={socials.x} class="underline" target="_blank">
            @{new URL(socials.x).pathname.replace("/", "")}
          </a>
        </span>
        <a href={new URL("/poems", site)} class="underline">more poems</a>
      </div>
    </footer>
  </article>
</RootLayout>

<style>
  .prose-poem :global(p) {
    white-space: pre-line;
  }
</style>
