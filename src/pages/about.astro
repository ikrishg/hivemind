---
import { Image } from "astro:assets";
import RootLayout from "~layouts/RootLayout.astro";
import { SiteContent } from "~lib/SiteContent";
import portrait from "~assets/krish-portrait.jpg";
import { socials, title } from "~shared";

const timeline = SiteContent.getAboutTimeline();

const socialLinks = [
  { label: "X", href: socials.x },
  { label: "LinkedIn", href: socials.linkedin },
  { label: "GitHub", href: socials.github },
  { label: "Instagram", href: socials.instagram },
  { label: "Substack", href: socials.substack },
  { label: "Email", href: socials.email },
] as const;
---

<RootLayout
  head={{
    title: "About | Krish Gupta",
    description:
      "About Krish Gupta — engineer, builder, sidequester. Started coding at 10, shipped reseter.css at 12, DevRel and backend since.",
  }}
>
  <div class="mx-8 py-12 lg:py-20">
    <div class="grid items-start gap-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16">
      <Image
        src={portrait}
        alt="Portrait of Krish Gupta"
        width={160}
        height={160}
        class="rounded-full border border-foreground/10"
      />

      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl font-bold md:text-6xl">About</h1>
        <p class="text-lg leading-relaxed">
          I'm {title}, {SiteContent.age}. Engineer, builder, sidequester — I
          started coding around 10 to build WordPress plugins, shipped{" "}
          <a
            href="https://github.com/ikrishg/reseter.css"
            class="underline underline-offset-4"
            target="_blank"
            rel="noopener noreferrer"
          >
            reseter.css
          </a>{" "}
          at 12, picked up DevRel young, and have been doing backend work since.
          I'm studying CS and statistics at Christ University in Bengaluru while
          building agentic AI and developer tooling.
        </p>
      </div>
    </div>

    <section class="mt-16 max-w-3xl">
      <h2 class="font-serif text-3xl font-bold">Timeline</h2>
      <ol class="mt-8 space-y-8 border-l border-foreground/15 pl-6">
        {
          timeline.map((entry) => (
            <li class="relative">
              <p class="text-sm font-medium uppercase tracking-wide text-foreground/60">
                {entry.period}
              </p>
              <p class="mt-2 leading-relaxed">{entry.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-16 max-w-3xl">
      <h2 class="font-serif text-3xl font-bold">Elsewhere</h2>
      <ul class="mt-6 flex flex-wrap gap-4">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="underline underline-offset-4"
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</RootLayout>
