---
import { Image } from "astro:assets";
import RootLayout from "~layouts/RootLayout.astro";
import { SiteContent } from "~lib/SiteContent";
import portrait from "~assets/krish-portrait.jpg";
import { socials, title } from "~shared";

const capabilities = SiteContent.getCapabilities();
const roles = SiteContent.getAboutRoles();
const timeline = SiteContent.getAboutTimeline();

const socialLinks = [
  { label: "X", href: socials.x },
  { label: "LinkedIn", href: socials.linkedin },
  { label: "GitHub", href: socials.github },
  { label: "Instagram", href: socials.instagram },
  { label: "Substack", href: socials.substack },
  { label: "Email", href: socials.email },
] as const;
---

<RootLayout
  head={{
    title: "About | Krish Gupta",
    description:
      "About Krish Gupta — engineer, builder, sidequester. Started coding at 10, shipped reseter.css at 12, DevRel and backend since.",
  }}
>
  <div class="site-shell">
    <div class="grid items-start gap-12 lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-20">
      <Image
        src={portrait}
        alt="Portrait of Krish Gupta"
        width={176}
        height={220}
        class="aspect-[4/5] w-full max-w-[11rem] object-cover"
      />

      <div class="max-w-2xl space-y-5">
        <p class="micro-label">About</p>
        <h1 class="display-serif text-5xl md:text-6xl">{title}</h1>
        <p class="text-lg leading-relaxed">
          I'm {SiteContent.age}, studying CS and statistics at Christ University
          in Bengaluru. I started coding around 10 to build WordPress plugins,
          shipped{" "}
          <a
            href="https://github.com/ikrishg/reseter.css"
            class="underline underline-offset-4 slow-hover hover:opacity-70"
            target="_blank"
            rel="noopener noreferrer"
          >
            reseter.css
          </a>{" "}
          at 12, picked up DevRel young, and have been doing backend work
          since. Available in {SiteContent.timezone}.
        </p>
      </div>
    </div>

    <hr class="site-rule mt-16 lg:mt-20" />

    <section class="mt-16 grid gap-16 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="micro-label">Capabilities</h2>
        <ul class="mt-6 space-y-4">
          {
            capabilities.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed">
                <span
                  class="accent-dot accent-dot--sky mt-2 shrink-0"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="micro-label">Roles</h2>
        <ul class="mt-6 divide-y divide-rule">
          {
            roles.map((role) => (
              <li class="py-5 first:pt-0 last:pb-0">
                <p class="font-medium">
                  {role.title}
                  <span class="text-ink-muted"> · {role.org}</span>
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                  {role.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <hr class="site-rule mt-16 lg:mt-20" />

    <section class="mt-16 max-w-2xl">
      <h2 class="micro-label">Timeline</h2>
      <ol class="mt-8 space-y-8">
        {
          timeline.map((entry) => (
            <li class="border-t border-rule pt-6 first:border-t-0 first:pt-0">
              <p class="micro-label">{entry.period}</p>
              <p class="mt-2 leading-relaxed">{entry.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <hr class="site-rule mt-16 lg:mt-20" />

    <section class="mt-12 max-w-2xl">
      <h2 class="micro-label">Elsewhere</h2>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm underline underline-offset-4 slow-hover hover:opacity-70"
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</RootLayout>
